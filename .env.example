# API Keys for AI Fitness Assistant
# Copy this file to .env and fill in your actual API keys

# GROQ API Key (for AI-powered fitness plan generation)
# Get your key at: https://groq.com/
REACT_APP_GROQ_API_KEY=your-groq-api-key-here

# Pexels API Key (for exercise and meal images)
# Get your key at: https://www.pexels.com/api/
REACT_APP_PEXELS_API_KEY=your-pexels-api-key-here

# Note: The app currently uses a fallback plan that works without API keys
# For full AI-powered features, add your API keys above
